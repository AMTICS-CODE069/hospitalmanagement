@model List<Post>
@{
    ViewData["Title"] = "Posts";
}

<h2>Posts</h2>

<table border="1" cellpadding="5">
    <tr>
        <th>Post ID</th>
        <th>Title</th>
    </tr>
    @foreach (var p in Model)
    {
        <tr>
            <td>@p.Id</td>
            <td>@p.Title</td>
        </tr>
    }
</table>
