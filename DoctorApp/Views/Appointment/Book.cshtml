@model Doctor
@{
    ViewData["Title"] = "Appointment";
}

<h2>Appointment Requested</h2>

<p>Patient: @ViewBag.PatientName</p>
<p>Doctor: @Model.DoctorName (Id: @Model.DoctorId)</p>
<p>Specialization selected: @(string.IsNullOrEmpty(ViewBag.Specialization) ? "All" : ViewBag.Specialization)</p>
<p>Date: @(((DateTime)ViewBag.Date).ToString("dd-MM-yyyy"))</p>
<p>Total Charge: ₹@Model.CalculateTotalCharge()</p>

<a asp-controller="Doctors" asp-action="Index">Back to Doctors</a>
